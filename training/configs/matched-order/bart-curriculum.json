{
  "run": "matched-order-20261108/bart-curriculum",
  "init": "facebook/bart-base",
  "learning_rate": 5e-05,
  "train": "${ORDER_DATA_ROOT}/curriculum/train",
  "errorful_only": false,
  "epochs": 1,
  "batch_size": 64,
  "grad_accum": 1,
  "warmup_steps": 2000,
  "loss_eval_steps": 2000,
  "save_steps": 2000,
  "errant_eval": {
    "steps": 2000,
    "sentences": 2000,
    "beams": 5,
    "patience": null
  },
  "dropout": 0.1,
  "weight_decay": 0.01,
  "label_smoothing": 0.1,
  "seed": 42,
  "save_total_limit": 2,
  "logging_steps": 50,
  "output_dir": "${CKPT_ROOT}/matched-order-20261108/bart-curriculum",
  "preserve_train_order": true,
  "logical_rounds": 8,
  "order_mode": "curriculum",
  "exposure_manifest": "${ORDER_DATA_ROOT}/manifest.json"
}
