{
  "run": "four-controls-20261108/bart-1b",
  "init": "facebook/bart-base",
  "learning_rate": 1e-05,
  "train": "${FOUR_CONTROL_DATA}/matched/train",
  "errorful_only": false,
  "epochs": 1,
  "batch_size": 32,
  "grad_accum": 1,
  "warmup_steps": 100,
  "loss_eval_steps": 4000,
  "save_steps": 4000,
  "errant_eval": {
    "steps": 4000,
    "sentences": 2000,
    "beams": 5,
    "patience": null
  },
  "dropout": 0.1,
  "weight_decay": 0.01,
  "label_smoothing": 0.1,
  "seed": 42,
  "save_total_limit": 2,
  "logging_steps": 50,
  "output_dir": "${CKPT_ROOT}/four-controls-20261108/bart-1b",
  "preserve_train_order": true,
  "exact_exposure_batches": true,
  "control_stream": "matched",
  "optimization_stage": 2,
  "logical_epochs": null
}
