{
  "run": "four-controls-20261108/bart-2a",
  "init": "facebook/bart-base",
  "learning_rate": 5e-05,
  "train": "${FOUR_CONTROL_DATA}/uniform3/train",
  "errorful_only": false,
  "epochs": 1,
  "batch_size": 64,
  "grad_accum": 2,
  "warmup_steps": 1000,
  "loss_eval_steps": 1000,
  "save_steps": 1000,
  "errant_eval": {
    "steps": 1000,
    "sentences": 2000,
    "beams": 5,
    "patience": null
  },
  "dropout": 0.1,
  "weight_decay": 0.01,
  "label_smoothing": 0.1,
  "seed": 42,
  "save_total_limit": 2,
  "logging_steps": 50,
  "output_dir": "${CKPT_ROOT}/four-controls-20261108/bart-2a",
  "preserve_train_order": true,
  "exact_exposure_batches": true,
  "control_stream": "uniform3",
  "optimization_stage": 1,
  "logical_epochs": 3
}
